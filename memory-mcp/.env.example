MCP_AUTH_TOKEN=
# Where the Markdown files live (use a persistent volume when hosted)
MEMORY_DIR=./memory-data
# Optional: sync to a private GitHub repo (fine-grained token with Contents read/write)
GIT_REMOTE=https://x-access-token:<token>@github.com/<you>/<memory-repo>.git
GIT_BRANCH=main
PORT=8787
